{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "functions": {
    "api/contact.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "onenationagency.com"
        }
      ],
      "destination": "https://www.onenationagency.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.onenationagency.com/$1",
      "permanent": true
    },
    {
      "source": "/afrique",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/afrique/",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/conseil-strategique",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/conseil-strategique/",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/e-reputation",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/e-reputation/",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/relations-presse",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/relations-presse/",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/reseaux-sociaux",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/reseaux-sociaux/",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/webmarketing",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/webmarketing/",
      "destination": "/services#communication",
      "permanent": true
    },
    {
      "source": "/design-graphique",
      "destination": "/services#web",
      "permanent": true
    },
    {
      "source": "/design-graphique/",
      "destination": "/services#web",
      "permanent": true
    },
    {
      "source": "/referencement",
      "destination": "/services#web",
      "permanent": true
    },
    {
      "source": "/referencement/",
      "destination": "/services#web",
      "permanent": true
    },
    {
      "source": "/en/africa",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/africa/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/strategic-consulting",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/strategic-consulting/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/online-reputation",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/online-reputation/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/e-reputation",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/e-reputation/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/press-relations",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/press-relations/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/social-media",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/social-media/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/digital-marketing",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/digital-marketing/",
      "destination": "/en/services#communication",
      "permanent": true
    },
    {
      "source": "/en/graphic-design",
      "destination": "/en/services#web",
      "permanent": true
    },
    {
      "source": "/en/graphic-design/",
      "destination": "/en/services#web",
      "permanent": true
    },
    {
      "source": "/en/seo",
      "destination": "/en/services#web",
      "permanent": true
    },
    {
      "source": "/en/seo/",
      "destination": "/en/services#web",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
