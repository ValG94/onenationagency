---
// Étoiles d'un avis. Le lecteur d'écran reçoit une seule annonce
// (« 5 étoiles sur 5 ») plutôt que cinq icônes muettes.
interface Props {
  rating: number;
  lang?: string;
  /** Taille en pixels d'une étoile. */
  size?: number;
}

const { rating, lang = 'fr', size = 15 } = Astro.props;
const en = lang === 'en';
const note = Math.max(0, Math.min(5, Math.round(rating)));
const label = en ? `${note} stars out of 5` : `${note} étoiles sur 5`;
---

<span class="tm-stars" role="img" aria-label={label}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      class:list={['tm-star', { 'tm-star--off': i >= note }]}
      aria-hidden="true"
    >
      <path d="M12 2l2.9 6.26 6.85.72-5.1 4.6 1.44 6.72L12 16.9l-6.09 3.4 1.44-6.72-5.1-4.6 6.85-.72z" />
    </svg>
  ))}
</span>

<style>
  .tm-stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .tm-star {
    fill: var(--gold);
    flex-shrink: 0;
  }
  /* Une étoile non acquise reste dessinée, mais en creux. */
  .tm-star--off {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.5;
    opacity: 0.35;
  }
</style>
