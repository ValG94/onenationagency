---
// ============================================================
// ONE NATION CIVIC — SECTION DE PRÉSENTATION
// ============================================================
// Solution propriétaire de One Nation Agency, présentée sur les
// deux accueils et sur les pages Intelligence artificielle.
//
// Le contenu FR/EN vit dans `src/data/civic.ts`. Ne rien recopier
// ici ni dans une page : ce composant est le seul rendu, la donnée
// est la seule source.
//
// Deux variantes :
//   variant="full"    → section complète (accueils)
//   variant="compact" → bandeau resserré, sans mockup ni features
//                       (pages expertise, pour éviter le doublon)
//
// L'aperçu est composé de deux captures réelles d'ONC (accueil +
// assistant mobile), passées par `astro:assets` donc en WebP avec
// srcset, et chargées en `lazy` : la section est loin sous la ligne
// de flottaison. Leur habillage (barre de navigateur, bordures)
// reprend les tokens ONA pour que le bloc reste dans la charte.
// ============================================================

import { Image } from 'astro:assets';
import { CIVIC_URL, CIVIC_ANCHOR, getCivicCopy } from '../data/civic';
import imgOncHome from '../assets/onc-home.jpg';
import imgOncPhone from '../assets/onc-phone.png';

interface Props {
  lang?: string;
  variant?: 'full' | 'compact';
  id?: string;
}

const { lang = 'fr', variant = 'full', id = CIVIC_ANCHOR } = Astro.props;
const en = lang === 'en';
const t = getCivicCopy(lang);

// Le formulaire de contact vit sur la page dédiée : on pointe vers
// son ancre plutôt que vers un bloc absent de la page courante.
const contactHref = en ? '/en/contact#contactForm' : '/contact#contactForm';

// Icônes alignées sur celles des cartes « piliers » : trait 1.5, 24x24.
const icons = [
  '<circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/>',
  '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/>',
  '<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18 15 15 0 010-18z"/>',
  '<path d="M17 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M17 11l2 2 4-4"/>',
  '<path d="M12 3l8 3v6c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
];
---

{variant === 'compact' ? (
  <section class="civic-compact" id={id} aria-labelledby={`${id}-title`}>
    <div class="container">
      <div class="civic-compact-inner reveal">
        <div class="civic-compact-text">
          <span class="label">{t.eyebrow}</span>
          <!-- h2 : ce bloc est une section sœur des autres sections de la
               page, pas une sous-partie. Seule la taille est réduite. -->
          <h2 id={`${id}-title`}>{t.title}</h2>
          <p>{t.compactLead}</p>
        </div>
        <a
          href={CIVIC_URL}
          class="btn-gold civic-compact-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.compactCta}
          <span class="civic-sr">{t.newTab}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </div>
    </div>
  </section>
) : (
  <section class="civic" id={id} aria-labelledby={`${id}-title`}>
    <div class="civic-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="civic-grid">

        <!-- Colonne gauche : discours -->
        <div class="civic-text">
          <span class="label reveal">{t.eyebrow}</span>
          <div class="gold-bar reveal"></div>
          <h2 id={`${id}-title`} class="reveal">{t.title}</h2>
          <p class="civic-subtitle reveal reveal-delay-1">{t.subtitle}</p>
          <p class="civic-lead reveal reveal-delay-1">{t.text}</p>

          <ul class="civic-features reveal reveal-delay-2">
            {t.features.map((feature, i) => (
              <li>
                <span class="civic-feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <div class="civic-actions reveal reveal-delay-3">
            <a href={CIVIC_URL} class="btn-gold" target="_blank" rel="noopener noreferrer">
              {t.ctaPrimary}
              <span class="civic-sr">{t.newTab}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
            </a>
            <a href={contactHref} class="btn-outline">{t.ctaSecondary}</a>
          </div>
        </div>

        <!-- Colonne droite : captures réelles de la plateforme. La barre de
             navigateur est en CSS, elle habille la capture sans l'alourdir. -->
        <div class="civic-visual reveal reveal-delay-2">
          <div class="civic-shots">
            <figure class="civic-shot-desktop">
              <div class="civic-mock-chrome" aria-hidden="true">
                <span class="civic-dot"></span><span class="civic-dot"></span><span class="civic-dot civic-dot--gold"></span>
                <span class="civic-mock-url">onenationcivic</span>
              </div>
              <Image
                src={imgOncHome}
                alt={t.shotDesktopAlt}
                loading="lazy"
                decoding="async"
                widths={[480, 760, 1100]}
                sizes="(max-width: 600px) 88vw, (max-width: 1024px) 70vw, 36vw"
              />
            </figure>
            <figure class="civic-shot-phone">
              <Image
                src={imgOncPhone}
                alt={t.shotPhoneAlt}
                loading="lazy"
                decoding="async"
                widths={[240, 380, 560]}
                sizes="(max-width: 600px) 58vw, (max-width: 1024px) 24vw, 12vw"
              />
            </figure>
          </div>
        </div>

      </div>

      <!-- Signature de marque -->
      <blockquote class="civic-philosophy reveal">
        <p>{t.philosophy}</p>
        <cite>One Nation Agency</cite>
      </blockquote>
    </div>
  </section>
)}

<style>
  /* ═══ SECTION COMPLÈTE ═══════════════════════════════════════ */
  .civic {
    position: relative;
    padding: var(--pad-section);
    /* Le dégradé évite deux aplats anthracite consécutifs entre le
       portfolio et le CTA final, sans sortir de la palette. */
    background: linear-gradient(180deg, var(--black) 0%, var(--anthracite) 50%, var(--black) 100%);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    overflow: hidden;
  }
  .civic-glow {
    position: absolute;
    top: -10%;
    right: -8%;
    width: 46rem;
    height: 46rem;
    max-width: 90vw;
    background: radial-gradient(circle, rgba(201,168,76,0.09) 0%, rgba(201,168,76,0) 68%);
    pointer-events: none;
  }
  .civic .container { position: relative; }

  .civic-grid {
    display: grid;
    /* Colonne visuelle légèrement dominante : à parts égales, les deux
       captures devenaient trop petites pour être lisibles. */
    grid-template-columns: 0.95fr 1.05fr;
    gap: 4rem;
    align-items: center;
  }
  /* Sans min-width:0, un enfant plus large que sa colonne (le mockup)
     élargit la colonne et pousse le texte hors de l'écran. */
  .civic-text,
  .civic-visual { min-width: 0; }

  /* ─── Colonne texte ─────────────────────────────────────────── */
  .civic-text h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  .civic-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 600;
    color: var(--off-white);
    line-height: 1.4;
    margin: 1.2rem 0 1.4rem;
  }
  .civic-lead {
    color: var(--grey-light);
    line-height: 1.8;
  }

  .civic-features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 1.5rem;
    margin: 2.4rem 0;
  }
  .civic-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--grey-light);
  }
  .civic-feature-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: rgba(201,168,76,0.08);
    border: 1px solid var(--border);
    color: var(--gold);
  }

  .civic-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  /* Les deux libellés ne tiennent pas côte à côte dans la demi-colonne :
     ils s'empilent en desktop et se remettent en ligne dès que la
     colonne occupe toute la largeur. Les boutons gardent le padding du
     design system, pas une valeur spécifique à cette section. */

  /* Libellé réservé aux lecteurs d'écran (ouverture dans un onglet). */
  .civic-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Colonne aperçu : composition des deux captures ────────── */
  .civic-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Repère de positionnement du téléphone. Le padding réserve la place
     de son débord sous la capture desktop, sinon il mord sur la suite. */
  .civic-shots {
    position: relative;
    width: 100%;
    max-width: 620px;
    padding-bottom: 15%;
  }

  /* Capture de l'accueil, habillée d'une barre de navigateur en CSS. */
  .civic-shot-desktop {
    width: 84%;
    margin: 0 0 0 auto;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(0,0,0,0.55);
  }
  .civic-shot-desktop img {
    width: 100%;
    height: auto;
    display: block;
  }

  .civic-mock-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.9rem;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid var(--border-light);
  }
  .civic-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.16);
  }
  .civic-dot--gold { background: var(--gold-dark); }
  .civic-mock-url {
    margin-left: auto;
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--grey);
  }

  /* Mockup mobile, en surimpression sur l'angle bas-gauche. */
  .civic-shot-phone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 28%;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 22px 55px rgba(0,0,0,0.62);
  }
  .civic-shot-phone img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ─── Signature ─────────────────────────────────────────────── */
  .civic-philosophy {
    max-width: 780px;
    margin: 6rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--border-light);
    text-align: center;
  }
  .civic-philosophy p {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.1vw, 1.5rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.55;
    color: var(--off-white);
  }
  .civic-philosophy p::before { content: '\201C'; }
  .civic-philosophy p::after  { content: '\201D'; }
  .civic-philosophy cite {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    font-style: normal;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ═══ VARIANTE COMPACTE ══════════════════════════════════════ */
  .civic-compact {
    padding: var(--pad-section);
    background: var(--anthracite);
    border-top: 1px solid var(--border-light);
  }
  .civic-compact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2.6rem 2.8rem;
  }
  .civic-compact-text h2 {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    margin: 0.7rem 0 0.8rem;
  }
  .civic-compact-text p {
    color: var(--grey-light);
    max-width: 46ch;
  }
  .civic-compact-cta { flex-shrink: 0; }

  /* ═══ RESPONSIVE ═════════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .civic-grid { grid-template-columns: 1fr; gap: 3.5rem; }
    .civic-visual { align-items: flex-start; }
    .civic-shots { max-width: 620px; }
    .civic-philosophy { margin-top: 4.5rem; }
  }

  @media (max-width: 768px) {
    .civic-features { grid-template-columns: 1fr; gap: 0.8rem; }
    .civic-compact-inner { flex-direction: column; align-items: flex-start; padding: 2rem 1.6rem; }
    .civic-compact-text p { max-width: none; }
  }

  /* Sous 600 px, la surimpression rendrait le téléphone illisible :
     les deux captures passent l'une sous l'autre. */
  @media (max-width: 600px) {
    .civic-shots { padding-bottom: 0; }
    .civic-shot-desktop { width: 100%; margin: 0; }
    .civic-shot-phone {
      position: static;
      width: 62%;
      margin: 1.5rem 0 0;
    }
  }

  @media (max-width: 480px) {
    .civic-actions { flex-direction: column; align-items: stretch; }
    .civic-actions a { justify-content: center; }
    .civic-compact-cta { width: 100%; justify-content: center; }
  }
</style>
