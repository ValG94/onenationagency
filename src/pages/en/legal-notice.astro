<style>
	.legal {
		padding: 8rem 0;
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	h1 {
		font-size: 3rem;
		text-align: center;
		margin-bottom: 4rem;
	}

	.legal-content {
		background: rgba(255, 255, 255, 0.05);
		padding: 3rem;
		border-radius: 12px;
	}

	h2 {
		font-size: 1.8rem;
		color: var(--color-accent);
		margin: 2.5rem 0 1rem;
	}

	h2:first-child {
		margin-top: 0;
	}

	p {
		margin: 0.8rem 0;
		line-height: 1.6;
	}

	/* Bloc d'adresse : légèrement détaché du texte courant pour qu'on
	   repère d'un coup d'œil l'éditeur, l'hébergeur et le registrar. */
	.legal-block {
		padding-left: 1rem;
		border-left: 2px solid var(--border);
		color: var(--off-white);
	}

	.legal-content a {
		color: var(--color-accent);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}
	.legal-content a:hover {
		border-bottom-color: var(--color-accent);
	}

	@media (max-width: 768px) {
		.legal {
			padding: 6rem 0;
		}

		h1 {
			font-size: 2.5rem;
			margin-bottom: 3rem;
		}

		.legal-content {
			padding: 2rem;
		}

		h2 {
			font-size: 1.5rem;
		}
	}

	/* Sous 480 px, la carte occupait presque tout l'écran en marges :
	   on rend la largeur au texte. */
	@media (max-width: 480px) {
		.legal-content {
			padding: 1.5rem 1.25rem;
		}

		h1 {
			font-size: 2rem;
		}

		.legal-block {
			padding-left: 0.85rem;
		}
	}
</style>
